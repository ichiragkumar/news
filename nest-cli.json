{
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps",
  "monorepo": true,
  "root": "apps/api-gateway",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "tsconfig.json"
  },
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "feed-svc": {
      "type": "application",
      "root": "apps/feed-svc",
      "entryFile": "main",
      "sourceRoot": "apps/feed-svc/src",
      "compilerOptions": {
        "tsConfigPath": "apps/feed-svc/tsconfig.app.json"
      }
    },
    "identity-svc": {
      "type": "application",
      "root": "apps/identity-svc",
      "entryFile": "main",
      "sourceRoot": "apps/identity-svc/src",
      "compilerOptions": {
        "tsConfigPath": "apps/identity-svc/tsconfig.app.json"
      }
    },
    "notification-worker": {
      "type": "application",
      "root": "apps/notification-worker",
      "entryFile": "main",
      "sourceRoot": "apps/notification-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-worker/tsconfig.app.json"
      }
    }
  }
}